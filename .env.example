# Path to the Stockfish executable. Installed via `winget install Stockfish.Stockfish`.
# A "stockfish" command-line alias was added to PATH (open a new shell to pick it up),
# but the direct path also works and needs no shell restart:
STOCKFISH_PATH=C:\Users\anita\AppData\Local\Microsoft\WinGet\Packages\Stockfish.Stockfish_Microsoft.Winget.Source_8wekyb3d8bbwe\stockfish\stockfish-windows-x86-64-avx2.exe

# Default search depth for analysis endpoints. Depth (not time) is used so
# evaluations are deterministic and cacheable by (fen, depth).
STOCKFISH_DEFAULT_DEPTH=18

# Lichess API. The main endpoints work anonymously, but the Opening Explorer at
# explorer.lichess.org now returns 401 without a token -- so book-exit analysis and
# the /explorer/* routes need this set. Create one (no scopes required) at
# https://lichess.org/account/oauth/token
LICHESS_TOKEN=

# Chess.com's public API needs no auth, but ask nicely with a contact-identifying UA.
CHESSCOM_USER_AGENT=chess-analyzer-app (contact: rayruenheck@gmail.com)

# Claude, for the coaching feedback endpoints. Get a key at https://console.anthropic.com/
# Without it the app still runs -- Stockfish analysis, the board, evals and the move
# list all work; only /feedback/* returns 503.
ANTHROPIC_API_KEY=

# Opus 5 is the default. Feedback is cached in SQLite by request hash, so re-reading
# a game you have already looked at costs nothing.
LLM_MODEL=claude-opus-5

# Reasoning depth for per-move and per-game feedback (low|medium|high|xhigh|max).
# The cross-game report always overrides this to "high" -- finding a pattern across
# 20 games is the one call worth spending real reasoning on.
LLM_EFFORT=low

# Ceiling for a single response. Thinking tokens are drawn from the same budget, so
# a report at high effort can spend most of it reasoning before it writes anything --
# set too low, the JSON is cut off mid-string and the call is wasted. Raise this if
# you see a 502 about the token limit.
LLM_MAX_TOKENS=32000
