# Path to the Stockfish executable. Installed via `winget install Stockfish.Stockfish`.
# A "stockfish" command-line alias was added to PATH (open a new shell to pick it up),
# but the direct path also works and needs no shell restart:
STOCKFISH_PATH=C:\Users\anita\AppData\Local\Microsoft\WinGet\Packages\Stockfish.Stockfish_Microsoft.Winget.Source_8wekyb3d8bbwe\stockfish\stockfish-windows-x86-64-avx2.exe

# Default search depth for analysis endpoints. Depth (not time) is used so
# evaluations are deterministic and cacheable by (fen, depth).
STOCKFISH_DEFAULT_DEPTH=18

# Lichess API (public endpoints work without a token; a token raises rate limits
# and is required for private data). Create one at https://lichess.org/account/oauth/token
LICHESS_TOKEN=

# Chess.com's public API needs no auth, but ask nicely with a contact-identifying UA.
CHESSCOM_USER_AGENT=chess-analyzer-app (contact: rayruenheck@gmail.com)
